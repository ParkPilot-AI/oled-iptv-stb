<?xml version="1.0" encoding="UTF-8"?>
<!-- Kiosk Openbox: no decorations, no menus, no shortcuts that could
     surprise a remote-control user. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <!-- Emergency exit from Games: ONYX gets no key presses while GeForce NOW has
         focus, so openbox closes it; ONYX notices and comes back on its own.
         Ctrl+Alt+Home on a keyboard, or the Home key many air-mouse remotes send. -->
    <keybind key="C-A-Home">
      <action name="Execute"><command>flatpak kill com.nvidia.geforcenow</command></action>
    </keybind>
    <keybind key="XF86HomePage">
      <action name="Execute"><command>flatpak kill com.nvidia.geforcenow</command></action>
    </keybind>
  </keyboard>
  <mouse/>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
    <!-- mpv must not take focus: the transparent overlay (always-on-top)
         keeps keyboard focus and stays above the video. -->
    <application class="mpv">
      <decor>no</decor>
      <focus>no</focus>
      <fullscreen>yes</fullscreen>
      <layer>normal</layer>
    </application>
    <!-- GeForce NOW (official Flatpak): full screen, undecorated, focused.
         Its X11 WM_CLASS is "GeForceNOW", "GeForceNOW" (as reported by xprop
         for com.nvidia.geforcenow; check with `xprop WM_CLASS` if NVIDIA changes it). -->
    <application class="GeForceNOW">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
      <layer>above</layer>
    </application>
  </applications>
</openbox_config>
