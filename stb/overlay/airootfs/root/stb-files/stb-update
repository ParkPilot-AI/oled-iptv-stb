#!/usr/bin/env bash
# ONYX set-top box updater (runs as root via a narrow sudoers rule).
#   stb-update check   → one JSON line: pending system updates + app versions
#   stb-update run     → update Arch packages, then the app; progress on stdout
#   stb-update provision → install packages/services/config added since the box was
#                      set up (Bluetooth, Games); quick no-op when nothing is missing
#   stb-update reboot  → reboot the box
#   stb-update games status|install|update → GeForce NOW Flatpak (status is JSON,
#                      install/update print '@@' progress)
#   stb-update bt status|scan [secs]|pair|connect|disconnect|forget <mac> → JSON
#   stb-update wifi status|scan|connect <ssid>|forget <ssid>
#                      → JSON; connect reads the passphrase from stdin
# Progress protocol: lines starting with "@@ " are machine-readable
#   @@ STEP <text> | @@ APP_UPDATED <version> | @@ REBOOT_REQUIRED | @@ DONE | @@ ERROR <text>
set -uo pipefail
# (sudo resets the environment, so the STB_* overrides below only work in tests.)
export LC_ALL=C PATH=${STB_PATH_PREFIX:+$STB_PATH_PREFIX:}/usr/local/sbin:/usr/local/bin:/usr/bin

CONF=/etc/stb/update.conf
REPO=""
GITHUB_TOKEN=""
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"
APP=${STB_APP_DIR:-/opt/oled-iptv}
API=${STB_GITHUB_API:-https://api.github.com}
LOG=${STB_UPDATE_LOG:-/var/log/stb-update.log}
LOCK=${STB_LOCK:-/run/stb-update.lock}

say() { echo "@@ $*"; }
fail() { say "ERROR $*"; exit 1; }

gh_curl() {
  local auth=()
  [[ -n $GITHUB_TOKEN ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
  curl -fsSL --retry 2 --connect-timeout 15 -H "X-GitHub-Api-Version: 2022-11-28" "${auth[@]}" "$@"
}

latest_release() { [[ -n $REPO ]] && gh_curl -H "Accept: application/vnd.github+json" "$API/repos/$REPO/releases/latest"; }

asset_id() { jq -r --arg n "$2" '.assets[] | select(.name == $n) | .id' <<<"$1" | head -n1; }

download_asset() { # json name dest
  local id; id=$(asset_id "$1" "$2")
  [[ -n $id && $id != null ]] || return 1
  gh_curl -H "Accept: application/octet-stream" -o "$3" "$API/repos/$REPO/releases/assets/$id"
}

installed_version() { cat "$APP/stb-version.txt" 2>/dev/null || echo unknown; }

cmd_check() {
  local sys latest="" rel tmp
  sys=$(checkupdates 2>/dev/null | wc -l)
  if rel=$(latest_release 2>/dev/null); then
    tmp=$(mktemp)
    download_asset "$rel" app-version.txt "$tmp" 2>/dev/null && latest=$(tr -d '[:space:]' <"$tmp")
    rm -f "$tmp"
  fi
  jq -cn --argjson system "${sys:-0}" --arg installed "$(installed_version)" --arg latest "$latest" \
    --arg repo "$REPO" --argjson token "$([[ -n $GITHUB_TOKEN ]] && echo true || echo false)" \
    '{system: $system, appInstalled: $installed, appLatest: $latest, repo: $repo, hasToken: $token}'
}

# Keep the box's own helpers and config in step with the app (shipped in the app
# package as stb-system/).
KIOSK_USER=${STB_KIOSK_USER:-tv}
# The running X session's display for the kiosk user's systemd services (the desktop
# portal needs it; openbox-autostart does the same at every login).
portal_display() {
  [[ -n ${STB_ROOT:-} ]] && return 0 # tests: no real user session
  local uid; uid=$(id -u "$KIOSK_USER" 2>/dev/null) || return 0
  [[ -S /run/user/$uid/bus && -S /tmp/.X11-unix/X0 ]] || return 0
  local home; home=$(getent passwd "$KIOSK_USER" | cut -d: -f6)
  local u=(runuser -u "$KIOSK_USER" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus")
  "${u[@]}" systemctl --user set-environment DISPLAY=:0 "XAUTHORITY=$home/.Xauthority" >/dev/null 2>&1 || return 0
  "${u[@]}" systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service >/dev/null 2>&1
  "${u[@]}" systemctl --user try-restart xdg-desktop-portal.service >/dev/null 2>&1
  return 0
}

install_system_files() {
  local src=$1
  [[ -d $src ]] || return 0
  local p="${STB_ROOT:-}" # test hook: install under a fake root
  # put <file> <dest> <mode>: atomic replace (a running copy of this script keeps
  # working). Returns 0 only when the file changed.
  put() {
    [[ -f $1 ]] || return 1
    cmp -s "$1" "$p$2" && return 1
    install -D -m "$3" "$1" "$p$2.new" && mv -f "$p$2.new" "$p$2"
  }
  put "$src/stb-update" /usr/local/sbin/stb-update 755
  put "$src/stb-audio.sh" /usr/local/bin/stb-audio 755
  put "$src/nm-stb.conf" /etc/NetworkManager/conf.d/stb.conf 644
  put "$src/portals.conf" /etc/xdg-desktop-portal/portals.conf 644
  put "$src/onyx-open-url" /usr/local/bin/onyx-open-url 755
  if put "$src/bluetooth-main.conf" /etc/bluetooth/main.conf 644; then
    # Only when the config changed (restarting drops connected controllers).
    systemctl try-restart bluetooth.service >/dev/null 2>&1 || true
  fi
  local home; home=$(getent passwd "$KIOSK_USER" | cut -d: -f6); home=${home:-/home/$KIOSK_USER}
  # Files in the kiosk user's home must stay theirs (install -D makes root-owned dirs).
  user_put() { # <src> <dest> [mode]
    put "$1" "$2" "${3:-644}" || return 1
    local d=$p$2
    while [[ $d != "$p$home" && $d != / && $d != . ]]; do
      chown "$KIOSK_USER:" "$d" 2>/dev/null || true
      d=$(dirname "$d")
    done
    return 0
  }
  user_put "$src/onyx-browser.desktop" "$home/.local/share/applications/onyx-browser.desktop" || true
  user_put "$src/mimeapps.list" "$home/.config/mimeapps.list" || true
  user_put "$src/openbox-autostart" "$home/.config/openbox/autostart" 755 || true
  portal_display
  if put "$src/openbox-rc.xml" "$home/.config/openbox/rc.xml" 644; then
    chown -R "$KIOSK_USER:$KIOSK_USER" "$p$home/.config/openbox" 2>/dev/null || true
    runuser -u "$KIOSK_USER" -- env DISPLAY=:0 openbox --reconfigure >/dev/null 2>&1 || true
  fi
  return 0
}

# Packages listed in packages.txt (comments and blank lines stripped), one per line.
list_packages() { [[ -f $1 ]] && sed 's/#.*//' "$1" | tr -s ' \t' '\n' | grep -v '^$'; }

# Make sure every package, service and config file the current app needs is
# present. sync=1: the package databases may be stale, so upgrade with the install
# (never a partial upgrade). Quick no-op when nothing is missing.
provision() {
  local src=$1 sync=${2:-0}
  local -a pkgs missing
  mapfile -t pkgs < <(list_packages "$src/packages.txt")
  if ((${#pkgs[@]})); then
    mapfile -t missing < <(pacman -T "${pkgs[@]}" 2>/dev/null)
    if ((${#missing[@]})); then
      say "STEP Installing ${#missing[@]} new package(s): ${missing[*]}"
      if ((sync)); then
        pacman -Syu --needed --noconfirm "${pkgs[@]}" || fail "Installing packages failed — see $LOG"
      else
        pacman -S --needed --noconfirm "${pkgs[@]}" || fail "Installing packages failed — see $LOG"
      fi
    fi
  fi
  install_system_files "$src"
  # The GPU's render node (/dev/dri/renderD*) is group 'render' with no seat ACL on
  # this box: without it apps fall back to slow software drawing (GeForce NOW shows
  # "Could not get DRI3 device … llvmpipe"). Takes effect at the next login/reboot.
  if [[ -z ${STB_ROOT:-} ]] && getent group render >/dev/null && id "$KIOSK_USER" >/dev/null 2>&1 &&
    [[ " $(id -nG "$KIOSK_USER") " != *" render "* ]]; then
    usermod -aG render "$KIOSK_USER" && say "STEP Gave $KIOSK_USER access to the graphics chip" && say "REBOOT_REQUIRED"
  fi
  if ! systemctl is-enabled bluetooth.service >/dev/null 2>&1 || ! systemctl is-active bluetooth.service >/dev/null 2>&1; then
    say "STEP Starting Bluetooth"
    systemctl enable --now bluetooth.service >/dev/null 2>&1 || true
  fi
}

update_app() {
  local rel latest
  rel=$(latest_release) || { say "STEP App: could not reach GitHub (check network / token) — skipped"; return 0; }
  WORK=$(mktemp -d /var/tmp/stb-app.XXXXXX)
  local work=$WORK
  download_asset "$rel" app-version.txt "$work/version" || { say "STEP App: no app build in the latest release — skipped"; return 0; }
  latest=$(tr -d '[:space:]' <"$work/version")
  if [[ $latest == "$(installed_version)" ]]; then
    say "STEP App is up to date ($latest)"
    return 0
  fi
  say "STEP Downloading app $latest"
  download_asset "$rel" oled-iptv-app.tar.zst "$work/app.tar.zst" || fail "App download failed"
  if download_asset "$rel" SHA256SUMS "$work/SHA256SUMS"; then
    (cd "$work" && grep ' oled-iptv-app.tar.zst$' SHA256SUMS | sed 's/oled-iptv-app.tar.zst$/app.tar.zst/' | sha256sum -c --status) ||
      fail "App download is corrupt (checksum mismatch)"
  fi
  say "STEP Installing app $latest"
  local new; new=$(mktemp -d "$(dirname "$APP")/.oled-iptv-new.XXXXXX")
  tar -C "$new" -I zstd -xf "$work/app.tar.zst" || { rm -rf "$new"; fail "Could not unpack the app"; }
  [[ -x $new/oled-iptv-player ]] || { rm -rf "$new"; fail "App package is incomplete"; }
  chmod 755 "$new"
  chown -R root:root "$new"
  [[ -f $new/chrome-sandbox ]] && chmod 4755 "$new/chrome-sandbox"
  rm -rf "$APP.old"
  [[ -d $APP ]] && mv "$APP" "$APP.old"
  mv "$new" "$APP"
  install_system_files "$APP/stb-system"
  say "APP_UPDATED $latest"
}

WORK=""
cleanup() { [[ -n $WORK ]] && rm -rf "$WORK"; }
trap cleanup EXIT

SELF_PATH=${STB_ROOT:-}/usr/local/sbin/stb-update

cmd_run() {
  exec 9>"$LOCK"
  flock -n 9 || fail "An update is already running"
  exec > >(tee -a "$LOG") 2>&1
  echo "=== $(date -Is) update started ==="
  # Fingerprint of this copy of the helper, to spot when the app update replaces it.
  local self_sum; self_sum=$(cksum <"${BASH_SOURCE[0]}" 2>/dev/null)

  say "STEP Refreshing package signing keys"
  pacman -Sy --noconfirm --needed archlinux-keyring || fail "Could not refresh package databases (network?)"

  say "STEP Updating system packages"
  pacman -Su --noconfirm || fail "System update failed — see $LOG"
  # Remove cached packages except the newest version to keep the disk tidy.
  paccache -rk1 >/dev/null 2>&1 || true

  update_app

  # pacman -Su only upgrades what's installed: add packages/services/config the app
  # needs now (e.g. Bluetooth, Flatpak). Uses the list from the app just installed.
  say "STEP Checking Bluetooth and Games support"
  if [[ -x $SELF_PATH && $(cksum <"$SELF_PATH" 2>/dev/null) != "$self_sum" ]]; then
    # The app update just installed a newer helper: let it do the rest, so files and
    # packages it knows about (and this copy doesn't) arrive in this same update.
    STB_LOCK_HELD=1 "$SELF_PATH" provision-run || fail "Finishing the update failed — see $LOG"
    say "DONE"
    return
  fi
  provision "$APP/stb-system" 0
  games_update # keeps GeForce NOW current with the normal 'Update system' button

  # The running kernel's modules are removed when a new kernel is installed.
  if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    say "REBOOT_REQUIRED"
  fi
  say "DONE"
}

# Second half of 'run', started by an older helper that has just updated itself.
# It still holds the lock (inherited fd 9) and its output already goes to the log.
cmd_provision_run() {
  [[ ${STB_LOCK_HELD:-} == 1 ]] || fail "provision-run is only for the updater itself"
  provision "$APP/stb-system" 0
  games_update
  if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    say "REBOOT_REQUIRED"
  fi
}

cmd_provision() {
  exec 9>"$LOCK"
  flock -n 9 || fail "An update is already running"
  exec > >(tee -a "$LOG") 2>&1
  echo "=== $(date -Is) provision started ==="
  say "STEP Checking Bluetooth and Games support"
  provision "$APP/stb-system" 1
  say "DONE"
}

# ---------------------------------------------------------------- Wi-Fi
# NetworkManager (wpa_supplicant) — works with Realtek USB dongles where iwd can't scan.
wifi_dev() {
  [[ -n ${STB_WIFI_DEV:-} ]] && { echo "$STB_WIFI_DEV"; return; }
  for d in /sys/class/net/*; do [[ -d $d/wireless ]] && basename "$d"; done | head -n1
}

# nmcli -t escapes ':' inside values as '\:' — split safely in jq.
NM_SPLIT='gsub("\\\\:"; "\u001f") | split(":") | map(gsub("\u001f"; ":"))'

wifi_status() {
  local dev=$1 drv state conn ip signal
  drv=$(basename "$(readlink -f "/sys/class/net/$dev/device/driver")" 2>/dev/null)
  state=$(nmcli -g GENERAL.STATE dev show "$dev" 2>/dev/null | head -n1)
  conn=$(nmcli -g GENERAL.CONNECTION dev show "$dev" 2>/dev/null | head -n1)
  ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -n1 | cut -d/ -f1)
  signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list ifname "$dev" --rescan no 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }')
  jq -cn --arg dev "$dev" --arg drv "$drv" --arg state "$state" --arg ssid "$conn" --arg ip "$ip" --arg signal "$signal" '
    {device: $dev, driver: $drv,
     state: (if ($state | test("^100")) then "connected" elif ($state | test("^(40|50|60|70|80|90)")) then "connecting" else "disconnected" end),
     ssid: (if ($state | test("^100")) then $ssid else "" end), ip: $ip,
     signal: ($signal | tonumber? // null), rssi: null, scanning: false}'
}

wifi_scan() {
  local dev=$1
  nmcli dev wifi rescan ifname "$dev" >/dev/null 2>&1
  sleep "${STB_SCAN_WAIT:-8}"
  nmcli -t -f IN-USE,SSID,SECURITY,SIGNAL dev wifi list ifname "$dev" --rescan no 2>/dev/null |
    jq -Rsc "[split(\"\\n\")[] | select(length > 0) | $NM_SPLIT |
      {ssid: .[1], security: (if (.[2] == \"\" or .[2] == \"--\") then \"open\" else .[2] end),
       signal: (.[3] | tonumber? // 0), connected: (.[0] == \"*\")}
      | select(.ssid != \"\" and .ssid != \"--\")]
      | group_by(.ssid) | map(max_by(.signal) + {connected: (map(.connected) | any)}) | sort_by(-.signal)"
}

cmd_wifi() {
  local dev; dev=$(wifi_dev)
  if [[ -z $dev ]]; then jq -cn '{error: "No Wi-Fi adapter found. Plug the USB Wi-Fi adapter in and try again."}'; return 1; fi
  nmcli radio wifi on >/dev/null 2>&1 || true
  case ${1:-} in
    status) wifi_status "$dev" ;;
    scan) jq -cn --argjson networks "$(wifi_scan "$dev")" --argjson status "$(wifi_status "$dev")" '$status + {networks: $networks}' ;;
    connect)
      [[ -n ${2:-} ]] || { jq -cn '{error: "No network name"}'; return 1; }
      local pass="" out
      IFS= read -r pass || true
      nmcli connection delete id "$2" >/dev/null 2>&1 || true
      if [[ -n $pass ]]; then out=$(nmcli dev wifi connect "$2" password "$pass" ifname "$dev" 2>&1)
      else out=$(nmcli dev wifi connect "$2" ifname "$dev" 2>&1); fi
      for _ in $(seq 1 20); do
        wifi_status "$dev" | jq -e '.state == "connected" and (.ip | length > 0)' >/dev/null && break
        sleep 1
      done
      if wifi_status "$dev" | jq -e '.state == "connected"' >/dev/null; then
        # Saved network should follow the adapter, whatever it is called.
        nmcli connection modify id "$2" connection.interface-name "" >/dev/null 2>&1 || true
        wifi_status "$dev"
      else
        nmcli connection delete id "$2" >/dev/null 2>&1 || true
        jq -cn --arg e "${out:-Could not connect. Check the password.}" '{error: ($e | split("\n") | map(select(length > 0)) | last // "Could not connect" | sub("^Error: "; ""))}'
        return 1
      fi ;;
    forget) nmcli connection delete id "${2:-}" >/dev/null 2>&1; wifi_status "$dev" ;;
    *) echo '{"error":"usage: wifi status|scan|connect <ssid>|forget <ssid>"}'; return 2 ;;
  esac
}

# ---------------------------------------------------------------- Bluetooth
# Game controllers via BlueZ (bluetoothctl, non-interactive). Every command prints
# one JSON line. MAC addresses are validated before they reach any command.
BT_SYS=${STB_BT_SYS:-/sys/class/bluetooth}
BT_GAMEPAD_RE='xbox|dualsense|dualshock|wireless controller|pro controller|8bitdo'

btctl() { timeout "${2:-10}" bluetoothctl $1 2>/dev/null; } # btctl "<args>" [seconds]

valid_mac() { [[ $1 =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; }

bt_has_adapter() {
  compgen -G "$BT_SYS/hci*" >/dev/null || return 1
  systemctl is-active --quiet bluetooth.service 2>/dev/null || pgrep -x bluetoothd >/dev/null 2>&1 || return 1
  # (not grep -q: with pipefail, closing the pipe early would count as a failure)
  [[ $(btctl show) == *Controller\ * ]]
}

# One device as JSON, from `bluetoothctl info <mac>`.
bt_device() {
  local mac=$1 info name icon
  info=$(btctl "info $mac")
  name=$(sed -n 's/^[[:space:]]*Name: //p' <<<"$info" | head -n1)
  [[ -z $name ]] && name=$(sed -n 's/^[[:space:]]*Alias: //p' <<<"$info" | head -n1)
  icon=$(sed -n 's/^[[:space:]]*Icon: //p' <<<"$info" | head -n1)
  jq -cn --arg mac "${mac^^}" --arg name "${name:-$mac}" --arg icon "$icon" --arg re "$BT_GAMEPAD_RE" \
    --arg paired "$(sed -n 's/^[[:space:]]*Paired: //p' <<<"$info" | head -n1)" \
    --arg connected "$(sed -n 's/^[[:space:]]*Connected: //p' <<<"$info" | head -n1)" \
    --arg trusted "$(sed -n 's/^[[:space:]]*Trusted: //p' <<<"$info" | head -n1)" \
    --arg battery "$(sed -n 's/^[[:space:]]*Battery Percentage: .*(\([0-9]*\)).*/\1/p' <<<"$info" | head -n1)" \
    '{mac: $mac, name: $name, paired: ($paired == "yes"), connected: ($connected == "yes"), trusted: ($trusted == "yes"),
      battery: ($battery | tonumber? // null),
      gamepad: ($icon == "input-gaming" or ($name | test($re; "i")))}'
}

# Devices as a JSON array: all known ones, or only paired (arg "paired").
bt_devices() {
  local filter=${1:-} line mac
  local -a devs=()
  while IFS= read -r line; do
    mac=$(awk '{print $2}' <<<"$line")
    valid_mac "$mac" || continue
    devs+=("$(bt_device "$mac")")
  done < <(btctl devices | grep '^Device ')
  ((${#devs[@]})) || { echo '[]'; return; }
  printf '%s\n' "${devs[@]}" | jq -cs --arg f "$filter" 'map(select(. != null)) | if $f == "paired" then map(select(.paired)) else . end'
}

bt_status() {
  if ! bt_has_adapter; then
    jq -cn '{adapter: false, powered: false, blocked: false, discovering: false, devices: []}'
    return 0
  fi
  local rf blocked=false show
  rf=$(rfkill list bluetooth 2>/dev/null)
  if grep -q 'Hard blocked: yes' <<<"$rf"; then
    blocked=true
  elif grep -q 'Soft blocked: yes' <<<"$rf"; then
    rfkill unblock bluetooth >/dev/null 2>&1 || true
    sleep 1
  fi
  show=$(btctl show)
  if [[ $blocked == false ]] && grep -q 'Powered: no' <<<"$show"; then
    btctl "power on" >/dev/null
    show=$(btctl show)
  fi
  jq -cn --argjson blocked "$blocked" --argjson devices "$(bt_devices paired)" \
    --arg powered "$(sed -n 's/^[[:space:]]*Powered: //p' <<<"$show" | head -n1)" \
    --arg disc "$(sed -n 's/^[[:space:]]*Discovering: //p' <<<"$show" | head -n1)" \
    '{adapter: true, powered: ($powered == "yes"), blocked: $blocked, discovering: ($disc == "yes"), devices: $devices}'
}

# Plain-English reason for a failed pair/connect.
bt_error() {
  local msg=$1
  case $msg in
    *"not available"* | *ConnectionAttemptFailed* | *"Page Timeout"* | *"timed out"* | *Timeout* | "")
      echo "Controller not in pairing mode — hold the pair button until the Xbox button flashes quickly" ;;
    *AuthenticationFailed* | *AuthenticationRejected* | *AuthenticationCanceled*)
      echo "The controller refused to pair — switch it off and on, then try again" ;;
    *"Not Powered"* | *NotReady*) echo "Bluetooth is off" ;;
    *InProgress*) echo "Already pairing — wait a moment and try again" ;;
    *) echo "Couldn't pair: $(grep -o 'org.bluez.Error.[A-Za-z]*\|Failed[^.]*' <<<"$msg" | head -n1)" ;;
  esac
}

cmd_bt() {
  local sub=${1:-} mac=${2:-}
  if [[ $sub != status && $sub != scan ]]; then
    valid_mac "$mac" || { jq -cn '{ok: false, error: "Invalid controller address"}'; return 1; }
    mac=${mac^^}
  fi
  if [[ $sub != status ]] && ! bt_has_adapter; then
    jq -cn '{ok: false, adapter: false, error: "No Bluetooth adapter found"}'
    return 1
  fi
  case $sub in
    status) bt_status ;;
    scan)
      local secs=${2:-12}
      [[ $secs =~ ^[0-9]+$ ]] || secs=12
      ((secs < 3)) && secs=3
      ((secs > 30)) && secs=30
      btctl "--timeout $secs scan on" $((secs + 5)) >/dev/null
      # Not-yet-paired controllers first, then other new devices, then known ones.
      jq -cn --argjson d "$(bt_devices)" '{adapter: true, devices: ($d | sort_by([.paired, (.gamepad | not), .name]))}' ;;
    pair)
      local out
      # Keep discovery running while pairing: LE controllers only answer while scanned.
      btctl "--timeout 40 scan on" 45 >/dev/null &
      local scan_pid=$!
      out=$(btctl "--timeout 30 pair $mac" 35)
      if ! grep -q 'Pairing successful\|AlreadyExists' <<<"$out"; then
        kill "$scan_pid" 2>/dev/null
        jq -cn --arg e "$(bt_error "$out")" '{ok: false, error: $e}'
        return 1
      fi
      btctl "trust $mac" >/dev/null
      out=$(btctl "--timeout 15 connect $mac" 20)
      kill "$scan_pid" 2>/dev/null
      btctl "scan off" >/dev/null
      if grep -q 'Connection successful' <<<"$out"; then jq -cn --argjson d "$(bt_device "$mac")" '{ok: true, device: $d}'
      else jq -cn --argjson d "$(bt_device "$mac")" '{ok: true, device: $d, warning: "Paired. Press the Xbox button to connect."}'; fi ;;
    connect)
      local out; out=$(btctl "--timeout 15 connect $mac" 20)
      if grep -q 'Connection successful' <<<"$out"; then jq -cn --argjson d "$(bt_device "$mac")" '{ok: true, device: $d}'
      else jq -cn '{ok: false, error: "Couldn'"'"'t connect — switch the controller on (press the Xbox button) and try again"}'; return 1; fi ;;
    disconnect)
      btctl "disconnect $mac" >/dev/null
      jq -cn --argjson d "$(bt_device "$mac")" '{ok: true, device: $d}' ;;
    forget)
      btctl "remove $mac" >/dev/null
      jq -cn '{ok: true}' ;;
    *) jq -cn '{ok: false, error: "usage: bt status|scan [secs]|pair|connect|disconnect|forget <mac>"}'; return 2 ;;
  esac
}

# ---------------------------------------------------------------- Games (GeForce NOW)
# NVIDIA's official GeForce NOW app for Linux is a Flatpak from NVIDIA's own repo
# (not Flathub); its runtime (org.freedesktop.Platform) comes from Flathub.
# Source: NVIDIA's Linux install commands, as documented on the Arch Wiki
# (https://wiki.archlinux.org/title/NVIDIA_GeForce_NOW) and NVIDIA's system
# requirements page (https://www.nvidia.com/en-us/geforce-now/system-reqs/).
GFN_REMOTE=GeForceNOW
GFN_REPO_URL=https://international.download.nvidia.com/GFNLinux/flatpak/geforcenow.flatpakrepo
GFN_APP_ID=com.nvidia.geforcenow
FLATHUB_URL=https://dl.flathub.org/repo/flathub.flatpakrepo

gfn_version() { flatpak info --system "$GFN_APP_ID" 2>/dev/null | sed -n 's/^[[:space:]]*Version:[[:space:]]*//p' | head -n1; }
gfn_installed() { flatpak info --system "$GFN_APP_ID" >/dev/null 2>&1; }

games_update() {
  command -v flatpak >/dev/null 2>&1 && gfn_installed || return 0
  say "STEP Updating GeForce NOW"
  flatpak update -y --noninteractive --system "$GFN_APP_ID" || say "STEP GeForce NOW update failed — will retry next time"
}

cmd_games() {
  case ${1:-} in
    status)
      if ! command -v flatpak >/dev/null 2>&1; then
        jq -cn '{installed: false, version: null, flatpak: false}'
      else
        jq -cn --arg v "$(gfn_version)" --argjson i "$(gfn_installed && echo true || echo false)" '{installed: $i, version: (if $v == "" then null else $v end), flatpak: true}'
      fi ;;
    install)
      exec 9>"$LOCK"
      flock -n 9 || fail "An update is already running"
      exec > >(tee -a "$LOG") 2>&1
      echo "=== $(date -Is) GeForce NOW install started ==="
      command -v flatpak >/dev/null 2>&1 || fail "Flatpak isn't installed yet — run 'Finish installing the update' first"
      say "STEP Adding NVIDIA's GeForce NOW repository"
      flatpak remote-add --system --if-not-exists flathub "$FLATHUB_URL" || fail "Couldn't add Flathub (network?)"
      flatpak remote-add --system --if-not-exists "$GFN_REMOTE" "$GFN_REPO_URL" || fail "Couldn't add NVIDIA's repository (network?)"
      say "STEP Downloading and installing GeForce NOW (this can take a few minutes)"
      flatpak install -y --noninteractive --system "$GFN_REMOTE" "$GFN_APP_ID" || fail "GeForce NOW install failed — see $LOG"
      say "STEP Installed GeForce NOW $(gfn_version)"
      say "DONE" ;;
    update)
      exec 9>"$LOCK"
      flock -n 9 || fail "An update is already running"
      games_update
      say "DONE" ;;
    *) echo '{"error":"usage: games status|install|update"}'; return 2 ;;
  esac
}

case ${1:-} in
  wifi) shift; cmd_wifi "$@" ;;
  bt) shift; cmd_bt "$@" ;;
  games) shift; cmd_games "$@" ;;
  check) cmd_check ;;
  provision) cmd_provision ;;
  provision-run) cmd_provision_run ;;
  run) cmd_run ;;
  reboot) systemctl reboot ;;
  poweroff) systemctl poweroff ;;
  *) echo "usage: stb-update check|run|provision|reboot|poweroff|wifi ...|bt ...|games status|install|update" >&2; exit 2 ;;
esac
