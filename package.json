{
  "name": "oled-iptv-player",
  "productName": "OLED IPTV",
  "version": "1.0.0",
  "description": "10-foot, keyboard/D-pad driven Xtream Codes IPTV player for OLED TVs, powered by mpv.",
  "main": "electron/main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/*.test.mjs test/stb/*.test.mjs",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:demo": "vite build --mode demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  }
}
